# OpenSearch container bootstrap password
OPENSEARCH_INITIAL_ADMIN_PASSWORD=DocIntel@121212

# Kafka broker and Kafka UI credentials.
KAFKA_USERNAME=admin
KAFKA_PASSWORD=DocIntel@12
USER_ADMIN_PASSWORD=DocIntel@1212

# PostgreSQL
POSTGRES_DB=document_db
POSTGRES_USER=doc_intel
POSTGRES_PASSWORD=DocIntel@121212

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=DocIntel@121212

# ============================================================
# Application
# Passed to the Doc Intel app container by compose.yml.
# ============================================================

# Kafka client identity (USER_TESTER_PASSWORD is also configured
# for this user in the Kafka broker above).
TEST_USER=test_user
USER_TESTER_PASSWORD=DocIntel@121212

# Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# MinIO
MINIO_HOST_URL=http://localhost:9000
MINIO_BUCKET_KEY=document

# OpenSearch client credentials
OPENSEARCH_PORT=9200
OPENSEARCH_HOST=localhost
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=DocIntel@121212

# JWT HMAC secret; use a random value with at least 32 characters.
JWT_SECRET=sadfafhcbylwbretv857245nb5n4j5b2

# Optional; defaults to update in the app container.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/document_db
#SPRING_JPA_HIBERNATE_DDL_AUTO=create
SPRING_JPA_HIBERNATE_DDL_AUTO=update
